* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
# Frozen protocol inputs carry byte hashes; never normalize their line endings.
experiments/glossary/protocols/**/*.json -text whitespace=cr-at-eol
*.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.wav binary
*.flac binary
*.mp3 binary
*.safetensors binary
*.pt binary
*.gguf binary
*.zip binary
